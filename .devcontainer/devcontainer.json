{
    "name":"bracelify",
    "dockerComposeFile":"../compose.dev.yml",
    "postStartCommand": "php bin/console tailwind:build --watch",
    "workspaceFolder": "/app",
    "service":"php",
    "customizations": {
        "vscode": {
        "extensions": [ 
            "github.copilot-chat",
            "bmewburn.vscode-intelephense-client",
            "mblode.twig-language-2",
            "whatwedo.twig",
            "bradlc.vscode-tailwindcss",
            "symfony.symfony-vscode",
            "MehediDracula.php-namespace-resolver",
             "junstyle.php-cs-fixer" ]

        }
    }
}