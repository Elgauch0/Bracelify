{
    "name": "bracelify",
    "dockerComposeFile": "../compose.dev.yml",
    "service": "php",
    "workspaceFolder": "/app",
    "shutdownAction": "stopCompose",
    "postStartCommand": "cd /app && php bin/console tailwind:build --watch",
    "remoteUser": "root",
    "customizations": {
        "vscode": {
            "extensions": [
                "github.copilot-chat",
                "bmewburn.vscode-intelephense-client",
                "mblode.twig-language-2",
                "bradlc.vscode-tailwindcss",
                "symfony.symfony-vscode",
                "MehediDracula.php-namespace-resolver",
                "junstyle.php-cs-fixer"
            ],
            "settings": {
                "php.suggest.basic": false,
                "intelephense.completion.fullyQualifyImport": true,
                "intelephense.memory": 1024,
                "php-cs-fixer.executablePath": "/app/vendor/bin/php-cs-fixer",
                "php-cs-fixer.onsave": true,
                "editor.formatOnSave": true
            }
        }
    }
}
