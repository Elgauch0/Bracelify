<!DOCTYPE html>
<html>
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">

		<title>
			{% block title %}Welcome!
			{% endblock %}
		</title>

		{# CSS #}
		{% block stylesheets %}
			<link rel="stylesheet" href="{{ asset('styles/app.css') }}">
		{% endblock %}
	</head>

	<body
		class="min-h-screen flex flex-col">

		{# Header #}
		{% include "partials/_header.html.twig" %}

		{# Menu en cours de développement #}
		{% include "partials/_encoursDev.html.twig" %}


		{# Contenu #}
		<main
			class="flex-1">
			{# Flash messages #}
			{% include "partials/_flashes_messages.html.twig" %}

			{# Body content #}
			{% block body %}{% endblock %}
		</main>

		{# Footer #}
		{% include "partials/_footer.html.twig" %}

		{# JS #}
		{% block javascripts %}
			{% block importmap %}
				{{ importmap('app') }}
			{% endblock %}
		{% endblock %}
	</body>

</html>
