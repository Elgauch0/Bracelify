{% extends 'base.html.twig' %}

{% block title %}Paiement Réussi
{% endblock %}

{% block body %}
	<div class="min-h-screen flex items-center justify-center bg-gray-50 px-4">
		<div class="max-w-md w-full bg-white p-8 rounded-2xl shadow-lg text-center">
			<div class="mx-auto flex items-center justify-center h-20 w-20 rounded-full bg-green-100 mb-6">
				<svg class="h-10 w-10 text-green-600" fill="none" stroke="currentColor" viewbox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
				</svg>
			</div>

			<h1 class="text-3xl font-extrabold text-gray-900 mb-2">Paiement validé !</h1>
			<p class="text-gray-600 mb-8">
				Merci pour votre confiance. Votre commande est en cours de préparation
			</p>

			<div class="bg-gray-50 rounded-lg p-4 mb-8 border border-gray-100">
				<span class="text-sm text-gray-500 uppercase font-semibold tracking-wider">Statut de la transaction</span>
				<p class="text-green-700 font-medium">Confirmée</p>
			</div>

			<div class="space-y-3">
				<a href="{{ path('app_public') }}" class="block w-full py-3 px-4 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-semibold shadow-md transition-all duration-200">
					Retour à la boutique
				</a>
				<p class="text-xs text-gray-400">
					Une question ?
					<a href="#" class="underline hover:text-gray-600">Contactez le support</a>
				</p>
			</div>
		</div>
	</div>
{% endblock %}
