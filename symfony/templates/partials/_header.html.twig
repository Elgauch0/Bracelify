<header data-controller="mobilebtn" class="bg-text shadow-md relative z-50">
	<div
		class="max-w-7xl mx-auto flex   justify-between">

		<!-- Logo -->
		<a href="/" class="flex items-center text-2xl font-bold text-tertiary focus:outline-none">
			<img src="{{ asset('images/logo.svg') }}" style="height:80px; width:auto;">
		</a>

		<!-- Navigation Principale (Desktop) -->
		<nav class="hidden md:flex items-center space-x-8">
			<a href="{{ path('app_public_products') }}" class="text-text-darker hover:text-text transition-colors duration-200 font-medium">Produits</a>
			<a href="{{ path('app_public_about') }}" class="text-text-darker hover:text-text transition-colors duration-200 font-medium">À propos</a>
			<a href="{{ path('app_contact') }}" class="text-text-darker hover:text-text transition-colors duration-200 font-medium">Contact</a>
		</nav>

		<!-- Actions Droite (Desktop) -->
		<div class="hidden md:flex items-center space-x-6">
			{% set cartQuantity = app.session.get('cart', [])|reduce((total, qty) => total + qty, 0) %}

			<!-- Panier -->
			{% if cartQuantity > 0 %}
				<a href="{{ path('app_cart_index') }}" class="relative p-2 text-text-darker hover:text-text transition-colors duration-200" aria-label="Mon panier">
					<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
						<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 0 0-16.536-1.84M7.5 14.25 5.106 5.272M6 20.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm12.75 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z"/>
					</svg>
					<span class="absolute top-0 right-0 transform translate-x-1/2 -translate-y-1/2 bg-red-600 text-white text-xs font-bold px-2 py-0.5 rounded-full min-w-[20px] text-center">
						{{ cartQuantity }}
					</span>
				</a>
			{% endif %}

			<!-- Authentification -->
			{% if app.user %}
				<a href="{{ logout_path() }}" class="text-text-darker border border-text-darker/20 px-4 py-2 rounded-lg hover:bg-text-darker hover:text-text transition-all duration-200 text-sm font-medium">
					Se déconnecter
				</a>
			{% else %}
				<a href="{{ path('app_login') }}" class="bg-tertiary text-white px-4 py-2 rounded-lg hover:bg-tertiary/90 transition-all duration-200 text-sm font-medium shadow-sm">
					Se connecter
				</a>
			{% endif %}
		</div>

		<!-- Bouton Menu Mobile (Burger) -->
		<button data-mobilebtn-target="burger" data-action="mobilebtn#toggle" class="md:hidden text-tertiary p-2 focus:outline-none" aria-label="Ouvrir le menu">
			<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-7 h-7">
				<path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"/>
			</svg>
		</button>
	</div>

	<!-- Menu Déroulant Mobile -->
	<nav data-mobilebtn-target="menu" class="hidden md:hidden bg-text-darker text-text border-t border-text/10 shadow-inner">
		<div class="px-4 py-3 space-y-3">
			<a href="{{ path('app_public_products') }}" class="block py-2 hover:text-white transition-colors">Produits</a>
			<a href="{{ path('app_public_about') }}" class="block py-2 hover:text-white transition-colors">À propos</a>
			<a href="{{ path('app_contact') }}" class="block py-2 hover:text-white transition-colors">Contact</a>

			{% if cartQuantity > 0 %}
				<a href="{{ path('app_cart_index') }}" class="block py-2 font-bold border-t border-text/10 pt-3">Mon Panier ({{ cartQuantity }})</a>
			{% endif %}

			<div class="border-t border-text/10 pt-3">
				{% if app.user %}
					<a href="{{ logout_path() }}" class="block py-2 text-red-400 hover:text-red-300 font-medium">
						Se déconnecter
					</a>
				{% else %}
					<a href="{{ path('app_login') }}" class="block py-2 text-white font-medium">
						Se connecter
					</a>
				{% endif %}
			</div>
		</div>
	</nav>
</header>
