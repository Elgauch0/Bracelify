{# templates/_partials/_flash_messages.html.twig #}

<div class="fixed top-4 right-4 z-50 flex flex-col gap-3 w-full max-w-sm">
	{% for label, messages in app.flashes %}
		{% for message in messages %}
			{# On définit la couleur selon le type de flash #}
			{% set bgColor = 'bg-blue-500' %}
			{% if label == 'success' %}
				{% set bgColor = 'bg-green-500' %}
			{% elseif label == 'danger' or label == 'error' %}
				{% set bgColor = 'bg-red-500' %}
			{% elseif label == 'warning' %}
				{% set bgColor = 'bg-yellow-500' %}
			{% endif %}

			<div class="{{ bgColor }} text-white px-6 py-4 rounded-lg shadow-xl flex justify-between items-center transform transition-all duration-500" role="alert">

				<div class="flex items-center">
					{% if label == 'success' %}
						<svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewbox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
						</svg>
					{% endif %}
					<span class="font-medium">{{ message }}</span>
				</div>

				{# Petit bouton de fermeture simple #}
				<button onclick="this.parentElement.remove()" class="ml-4 opacity-70 hover:opacity-100 transition">
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewbox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
					</svg>
				</button>
			</div>
		{% endfor %}
	{% endfor %}
</div>
