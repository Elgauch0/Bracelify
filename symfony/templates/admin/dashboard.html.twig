{% extends '@EasyAdmin/page/content.html.twig' %}

{% block title %}Dashboard Admin
{% endblock %}

{% block head_javascript %}
	{{  importmap('app') }}
{% endblock %}

{% block main %}

	<div class="container-fluid p-4">
		<h1 class="mb-4">Dashboard Admin</h1>
		<div class="card p-3 shadow-sm">
			<p>Bienvenue sur votre gestion des ventes.</p>

			{{ render_chart(chart) }}

		</div>
		<p>Total des ventes pour le mois sélectionné :
			<strong>
				{{ totalSales | number_format(2, ',', ' ') }}
				€</p>
		</p>
	</div>
	<div class="container-fluid p-4">
		<div class="card p-3 shadow-sm">
			<h2>Top 5 des clients du mois</h2>
			<table class="table table-striped">
				<thead>
					<tr>
						<th>Client</th>
						<th>Total dépensé (€)</th>
					</tr>
				</thead>
				<tbody>
					{% for client in bestClients %}
						<tr>
							<td>{{ client.clientEmail }}</td>
							<td>{{ (client.totalSpent) | number_format(2, ',', ' ') }}</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	</div>
	<div class="admin-filter mb-4">
		<form id="dateFilterForm" method="get" class="d-flex align-items-center gap-2">
			<label for="date" class="fw-bold">Période :</label>

			<input
			type="month" id="date" name="date" value="{{ currentDateValue }}" class="form-control" style="width: auto;" onchange="this.form.submit()">
			{# Soumet dès qu'on choisit un mois #}

			<noscript>
				<button type="submit" class="btn btn-primary">Filtrer</button>
			</noscript>
		</form>
	</div>

{% endblock %}
