{% extends 'base.html.twig' %}

{% block body %}
	<div
		class="container mx-auto px-4 py-8 ">

		{# 1. On vérifie si le panier n'est pas vide via l'objet cart #}
		{% if cart.items is not empty %}

			<div class="flex flex-col gap-20 justify-center items-center">
				<div class="w-full lg:w-2/3">
					<table class="w-full text-left">
						<thead>
							<tr class="border-b">
								<th class="px-6 py-4">Produit</th>
								<th class="px-6 py-4">Quantité</th>
								<th class="px-6 py-4">Prix total</th>
								<th class="px-6 py-4">Actions</th>
							</tr>
						</thead>
						<tbody>
							{# 2. On boucle sur cart.items #}
							{% for item in cart.items %}
								<tr class="border-b">
									<td class="px-6 py-4 font-bold">{{ item.product.name }}</td>
									<td class="px-6 py-4">{{ item.quantity }}</td>
									<td class="px-6 py-4">{{ item.total /100 }}
										€</td>
									<td class="px-6 py-4">
										<form action="{{ path('app_cart_remove', {id: item.product.id}) }}" method="POST">
											<input type="hidden" name="_token" value="{{ csrf_token('remove' ~ item.product.id) }}">
											<button type="submit" class="text-red-500">Supprimer</button>
										</form>

									</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>

				{# 3. On affiche le total via cart.total #}
				<div class="w-full lg:w-1/3">
					<div class="bg-gray-50 p-6 rounded-xl">
						<h2 class="text-xl font-bold">Total :
							{{ cart.total /100 }}
							€</h2>
					</div>
				</div>
			</div>

			{# 4. On ajoute un lien vers la page de paiement #}
			<div class="mt-8 text-center">
				<a href="{{ path('app_payment_checkout') }}" class="bg-blue-500 text-white px-6 py-3 rounded-lg hover:bg-blue-600 transition">Passerau paiement</a>
			</div>

		{% else %}
			<p>Votre panier est vide.</p>
		{% endif %}

	</div>
{% endblock %}
