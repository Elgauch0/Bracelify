<div
	class="bg-white rounded-xl shadow hover:shadow-lg transition p-4">

	{# Image principale #}
	{% set firstImage = product.productImages|first %}

	{% if firstImage %}
		<img src="/images/products/{{ firstImage.imageName }}" alt="{{ product.description }}" class="w-full h-48 object-cover rounded-lg mb-4">
	{% else %}
		<div class="w-full h-48 bg-gray-200 rounded-lg mb-4"></div>
	{% endif %}

	<h3 class="text-lg font-semibold text-gray-900">{{ product.name }}</h3>

	{% if product.discount > 0 %}
		<div class="mt-2">
			<span class="text-red-600 font-bold">
				{{ (product.price - product.discount) / 100 }}
				€
			</span>
			<span class="line-through text-gray-500 ml-2">
				{{ product.price / 100 }}
				€
			</span>
		</div>
	{% else %}
		<p class="text-gray-800 font-semibold mt-2">
			{{ product.price / 100 }}
			€
		</p>
	{% endif %}

	<a href="{{ path('app_public_show', {id: product.id}) }}" class="mt-4 inline-block bg-tertiary text-white px-4 py-2 rounded-lg hover:bg-secondary transition">
		Voir le produit
	</a>
</div>
