{% extends 'base.html.twig' %}

{% block title %}Contact | Bracelify
{% endblock %}

{% block body %}
	<div class="min-h-screen bg-gray-50 flex items-center  justify-center px-4 sm:px-6 lg:px-8">
		<div class="w-full max-w-4xl bg-white rounded-xl shadow-md overflow-hidden p-8 border border-gray-100">

			<div class="text-center mb-8">
				<h1 class="text-3xl font-extrabold text-gray-900">Contactez l'admin</h1>
				<p class="mt-2 text-gray-600">Une question sur vos bracelets ? On vous répond.</p>
			</div>

			{# Gestion des notifications Flash #}


			{{ form_start(contactForm, {'attr': {'class': 'space-y-6'}}) }}

			<div>
				{{ form_label(contactForm.email, 'Votre adresse email', {'label_attr': {'class': 'block text-sm font-semibold text-gray-700'}}) }}
				<div class="mt-1">
					{{ form_widget(contactForm.email, {'attr': {'class': 'block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm p-2.5 border', 'placeholder': 'nom@exemple.com'}}) }}
				</div>
				<div class="text-red-500 text-xs mt-1">{{ form_errors(contactForm.email) }}</div>
			</div>

			<div>
				{{ form_label(contactForm.subject, 'Sujet', {'label_attr': {'class': 'block text-sm font-semibold text-gray-700'}}) }}
				<div class="mt-1">
					{{ form_widget(contactForm.subject, {'attr': {'class': 'block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm p-2.5 border'}}) }}
				</div>
				<div class="text-red-500 text-xs mt-1">{{ form_errors(contactForm.subject) }}</div>
			</div>

			<div>
				{{ form_label(contactForm.message, 'Votre message', {'label_attr': {'class': 'block text-sm font-semibold text-gray-700'}}) }}
				<div class="mt-1">
					{{ form_widget(contactForm.message, {'attr': {'class': 'block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm p-2.5 border', 'rows': 4}}) }}
				</div>
				<div class="text-red-500 text-xs mt-1">{{ form_errors(contactForm.message) }}</div>
			</div>

			<div>
				<button type="submit" class="w-full flex justify-center py-3 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-tertiary hover:bg-primary focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors">
					Envoyer le message
				</button>
			</div>

			{{ form_end(contactForm) }}
		</div>
	</div>
{% endblock %}
