{% extends 'base.html.twig' %}

{% block title %}se connecter!
{% endblock %}

{% block body %}
	<div class="min-h-screen flex items-center justify-center px-4">
		<div class="w-full max-w-md bg-white p-6 rounded-lg shadow">

			{% if error %}
				<div class="mb-4 p-3 rounded bg-red-100 text-red-700 text-sm">
					{{ error.messageKey | trans(error.messageData, 'security') }}
				</div>
			{% endif %}

			{% if app.user %}
				<div class="mb-4 text-sm text-gray-700">
					Connecté en tant que
					<span class="font-semibold">{{ app.user.userIdentifier }}</span>.
					<a href="{{ logout_path() }}" class="text-blue-600 hover:underline ml-1">Déconnexion</a>
				</div>
			{% endif %}

			<h1 class="text-xl font-bold text-tertiary mb-6 text-center">
				Veuillez vous connecter
			</h1>

			<form method="post" class="space-y-4">

				<div>
					<label for="username" class="block text-gray-700 mb-1">Email :</label>
					<input type="email" value="{{ last_username }}" name="_username" id="username" autocomplete="email" required autofocus class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-tertiary focus:outline-none">
				</div>

				<div>
					<label for="password" class="block text-gray-700 mb-1">Mot de passe :</label>
					<input type="password" name="_password" id="password" autocomplete="current-password" required class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-tertiary focus:outline-none">
				</div>

				<input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

				<button type="submit" class="w-full bg-tertiary text-white py-2 rounded-lg hover:bg-secondary transition">
					Se connecter
				</button>
			</form>
			<a href="{{ path('app_register') }}" class="block mt-4 text-center text-tertiary hover:underline">
				Pas encore de compte ? Inscrivez-vous ici.
			</a>
		</div>
	</div>
{% endblock %}
